{
	"name": "obsidian-quick-bookmarks-plugin",
	"version": "1.2.0",
	"description": "Quickly access bookmarks through a fuzzy search modal.",
	"main": "main.js",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"test": "vitest run",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"update": "ncu -i",
		"lint": "eslint --fix",
		"lint:fix": "eslint . --fix",
		"format": "prettier --config prettier.config.cjs --ignore-path .prettierignore --write .",
		"format:check": "prettier --config prettier.config.cjs --ignore-path .prettierignore --check ."
	},
	"keywords": [],
	"author": "Kieran Mansfield",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"esbuild": "0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "latest",
		"prettier": "^3.9.10",
		"ts7": "npm:typescript@7.0.2",
		"tslib": "2.9.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
